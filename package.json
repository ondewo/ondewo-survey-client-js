{
  "name": "@ondewo/ondewo-survey-client-js",
  "version": "2.0.1",
  "description": "ONDEWO Survey (SURVEY) Client library for Js",
  "author": "ONDEWO GmbH",
  "homepage": "https://ondewo.com",
  "license": "Apache-2.0",
  "keywords": [
    "ondewo",
    "survey",
    "api",
    "client",
    "js",
    "grpc"
  ],
  "scripts": {
    "build": "docker run -v ${PWD}:/input-volume -v ${PWD}/../api:/output-volume ondewo-js-proto-compiler ondewo-survey-api ondewo-survey-api ondewo",
    "test": "c8 --check-coverage --lines 100 --branches 100 --functions 100 --include auth/offlineTokenProvider.js --exclude '**/*.spec.js' --reporter text node --test auth/offlineTokenProvider.spec.js",
    "test:examples": "node --test example/getSurveyExample.spec.js"
  },
  "repository": {
    "type": "git",
    "directory": "https://github.com/ondewo/ondewo-survey-client-js.git"
  },
  "dependencies": {
    "google-protobuf": "^3.21.4",
    "grpc-web": "^1.5.0",
    "terser-webpack-plugin": "^5.3.14",
    "undici": "^6.27.0",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "c8": "^11.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.5",
    "global": "^4.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6"
  }
}
